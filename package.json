{
  "name": "race-buddy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "verify": "next typegen && npm run lint && npm run typecheck && npm run tokens:check && npm run security:check && npm test",
    "build:vercel": "npm run verify && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:live": "node --env-file-if-exists=.env.local scripts/live-check.mts",
    "samples:add": "node --env-file-if-exists=.env.local scripts/sample-athletes.mts add",
    "samples:remove": "node --env-file-if-exists=.env.local scripts/sample-athletes.mts remove",
    "sync:tickettailor": "node --env-file-if-exists=.env.local scripts/sync-ticket-tailor.mts",
    "test:smoke": "node --experimental-strip-types scripts/smoke-check.mts",
    "migrations:check": "node --experimental-strip-types scripts/check-migrations.mts",
    "test:db": "bash supabase/tests/run-tests.sh",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "tokens": "node --experimental-strip-types scripts/build-tokens.mts",
    "tokens:check": "node --experimental-strip-types scripts/build-tokens.mts --check",
    "security:check": "node --experimental-strip-types scripts/security-check.mts",
    "test:brand": "playwright test",
    "test:brand:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@sentry/browser": "^11.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "type": "module"
}

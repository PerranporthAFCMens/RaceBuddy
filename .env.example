# Copy to .env.local for local development. Never commit real values.

# Which site this is: dev (test site, branch dev) or live (branch main).
# Leave blank on a laptop. See ENVIRONMENT.md.
NEXT_PUBLIC_SITE_ENV=

# Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used to mark tickets as verified and to sync events.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address of the app, used in sign-up emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ticket Tailor: KeltX's key (Box office settings > API). Server only.
TICKET_TAILOR_API_KEY=

# Match alert emails (Resend: resend.com > API Keys). Server only.
RESEND_API_KEY=
# Sender, e.g. "Race Buddy <alerts@yourdomain>". Must be on a domain verified
# in Resend. Leave blank to use Resend's test sender (only reaches your own inbox).
EMAIL_FROM=
# Optional: protects the daily alerts job (/api/cron/alerts).
CRON_SECRET=

# Copy to .env.local for local development. Never commit real values.

# Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used to mark tickets as verified and to sync events.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address of the app, used in sign-up emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ticket Tailor: KeltX's key (Box office settings > API). Server only.
TICKET_TAILOR_API_KEY=
